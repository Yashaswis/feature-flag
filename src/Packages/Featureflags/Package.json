
{
    "name": "@company/feature-flags",
    "version": "0.1.0",
    "description": "Reusable OpenFeature React SDK",
    "type": "module",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "require": "./dist/index.cjs"
      }
    },
    "files": ["dist"],
    "scripts": {
      "build": "tsc -p tsconfig.json"
    },
    "peerDependencies": {
      "react": "^18.0.0 || ^19.0.0",
      "@openfeature/core": "^1.12.0",
      "@openfeature/web-sdk": "^1.10.0",
      "@openfeature/react-sdk": "^1.4.1"
    },
    "devDependencies": {
      "tsup": "^9.0.0",
      "typescript": "~7.0.2"
    }
  }
  